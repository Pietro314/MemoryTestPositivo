// Coloque este arquivo em: device/<vendor>/<product>/memtest_daemon/Android.bp
// Daemon de fábrica em SYSTEM_EXT partition (coredomain) — vai para /system_ext/bin/
// Necessário (vs vendor) porque o neverallow do AOSP impede apps de
// conectarem em sockets Unix de vendor domains.

cc_binary {
    name: "memtest_daemon",
    srcs: ["memtest_daemon.c"],
    init_rc: ["memtest_daemon.rc"],
    system_ext_specific: true,
    compile_multilib: "first",
    stl: "none",
    shared_libs: [],
    static_libs: [],
    cflags: [
        "-Wall",
        "-Wextra",
        "-O2",
    ],
}

// Instala os scripts em /system_ext/etc/factory/
prebuilt_etc {
    name: "full_memtest_sh",
    src: "scripts/full_memtest.sh",
    sub_dir: "factory",
    system_ext_specific: true,
    filename_from_src: true,
}

prebuilt_etc {
    name: "ram_diagnostic_deep_verbose_root_exec_sh",
    src: "scripts/ram_diagnostic_deep_verbose_root_exec.sh",
    sub_dir: "factory",
    system_ext_specific: true,
    filename_from_src: true,
}
