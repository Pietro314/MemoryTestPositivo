# SELinux policy para o memtest_daemon (system_ext / coredomain)
# Coloque em: device/sprd/mpool/sepolicy/system/private/memtest_daemon.te
#
# Versão minimalista: evita dependências de atributos partição-específicos
# (system_ext_file_type, core_data_file_type) que falham quando o .te é
# compilado em contextos como plat_policy_for_vendor.cil.
# Tudo o que não está aqui é coberto por `permissive memtest_daemon` em runtime.

type memtest_daemon, domain, coredomain;
type memtest_daemon_exec, exec_type, file_type;
type memtest_daemon_data_file, file_type, data_file_type;
type memtest_daemon_socket, file_type;

# Domain transition a partir do init
init_daemon_domain(memtest_daemon);

# Permissive: ferramenta de fábrica, roda apenas em userdebug/eng.
permissive memtest_daemon;

# Capacidades — apenas as que passam no neverallow para coredomain
allow memtest_daemon self:capability {
    sys_admin
    setuid
    setgid
    fowner
    chown
    kill
};

# Socket Unix
allow memtest_daemon memtest_daemon_socket:sock_file { create unlink };
allow memtest_daemon self:unix_stream_socket {
    create bind listen accept read write getattr setopt
};

# Diretório de trabalho em /data/vendor/memtest
allow memtest_daemon memtest_daemon_data_file:dir  {
    create write add_name read open search getattr rmdir
};
allow memtest_daemon memtest_daemon_data_file:file {
    create write open read getattr unlink
};
