# Permite que o APK (untrusted_app) conecte ao socket do daemon.
# Como memtest_daemon agora é coredomain (não vendor), o neverallow
# da linha 716 de domain.te NÃO se aplica.
#
# Coloque em: device/<vendor>/<product>/sepolicy/private/untrusted_app_memtest.te

allow untrusted_app memtest_daemon_socket:sock_file { write };
allow untrusted_app memtest_daemon:unix_stream_socket connectto;
